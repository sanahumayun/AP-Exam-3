<pre><span>"dependencies": {</span><br><span>    "cors": "^2.8.5",</span><b=
r><span>    "express": "^4.18.3",</span><br><span>    "http": "^0.0.1-secur=
ity",</span><br><span>    "socket.io": "^4.7.4"</span><br><span>}</span></p=
